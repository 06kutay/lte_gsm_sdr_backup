# hw-worker-sdr Environment Configuration

# gRPC microservice listening port
GRPC_PORT=50051

# ZMQ PUB port for real-time progress events
ZMQ_PUB_PORT=5556

# Core main backend gRPC registration address
BACKEND_GRPC_ADDR=localhost:50050

# SDR Hardware configuration: "limesdr" or "usrp"
SDR_TYPE=limesdr

# USB serial number of this specific SDR unit (e.g. 1DBB4CC5EE717D)
SDR_SERIAL=1DBB4CC5EE717D

# Role of this worker instance: "high" (>= 1500MHz) or "low" (< 1500MHz)
SDR_ROLE=high

# Antenna port override (optional, defaults to LNAH for LimeSDR high, LNAW for low)
SDR_ANTENNA=LNAH

# Frequency threshold dividing high band and low band in MHz (default: 1500)
FREQ_THRESHOLD_MHZ=1500

# Default SDR RX Gain in dB
DEFAULT_GAIN=40

# Default initial scan timeout for each channel in seconds
DEFAULT_TIMEOUT=20

# Additional timeout added per successfully decoded SIB in seconds
DEFAULT_EXTRA_TIMEOUT=10

# Host symlink / device node path for the SDR
DEVICE_PATH=/dev/sdr_device_1

# Set to true to emulate SDR presence and scan stdout in non-hardware environments
MOCK_SDR=false
